From 506a27371ab713ce769fdea4937a710dd9da1a17 Mon Sep 17 00:00:00 2001
From: Peter Zhigalov <peter.zhigalov@gmail.com>
Date: Tue, 29 Sep 2026 04:26:35 +0700
Subject: [PATCH 2/2] M4: disable strchrnul

m4-1.4.21/lib/spawni.c:1068:11: error: 'strchrnul' is only available on macOS 15.4 or newer

gsed -i 's|\(ac_fn_c[^ ]* [^ ]* "strchrnul\)"|\1_LOCAL"|' configure
find . \( -name '*.h' -or -name '*.c' \) -exec gsed -i 's|\([( ]strchrnul\)|\1_LOCAL|g ; s|^\(strchrnul\)|\1_LOCAL|g' \{\} \;
---
 configure              | 12 ++++++------
 lib/spawni.c           |  4 ++--
 lib/strchrnul.c        |  2 +-
 lib/string.in.h        | 20 ++++++++++----------
 tests/test-strchrnul.c | 24 ++++++++++++------------
 5 files changed, 31 insertions(+), 31 deletions(-)

diff --git a/configure b/configure
index 3fb9847..1590209 100755
--- a/configure
+++ b/configure
@@ -61366,14 +61366,14 @@ else case e in #(
        case "$host_os" in
 
          linux*-android*)
-           ac_fn_check_decl "$LINENO" "strchrnul" "ac_cv_have_decl_strchrnul" "#include <string.h>
+           ac_fn_check_decl "$LINENO" "strchrnul_LOCAL" "ac_cv_have_decl_strchrnul" "#include <string.h>
 " "$ac_c_undeclared_builtin_options$ac_c_future_darwin_options" "CFLAGS"
 if test "x$ac_cv_have_decl_strchrnul" = xyes
 then :
 
 fi
            if test $ac_cv_have_decl_strchrnul = yes; then
-             ac_fn_c_check_func "$LINENO" "strchrnul" "ac_cv_func_strchrnul"
+             ac_fn_c_check_func "$LINENO" "strchrnul_LOCAL" "ac_cv_func_strchrnul"
 if test "x$ac_cv_func_strchrnul" = xyes
 then :
 
@@ -61397,7 +61397,7 @@ fi
              saved_ac_compile_for_check_decl="$ac_compile_for_check_decl"
              ac_compile_for_check_decl="$ac_compile_for_check_decl $gl_cv_compiler_check_future_option"
              unset ac_cv_have_decl_strchrnul
-             ac_fn_check_decl "$LINENO" "strchrnul" "ac_cv_have_decl_strchrnul" "#include <string.h>
+             ac_fn_check_decl "$LINENO" "strchrnul_LOCAL" "ac_cv_have_decl_strchrnul" "#include <string.h>
 " "$ac_c_undeclared_builtin_options$ac_c_future_darwin_options" "CFLAGS"
 if test "x$ac_cv_have_decl_strchrnul" = xyes
 then :
@@ -61415,7 +61415,7 @@ fi
                ac_cxx_future_darwin_options_saved="$ac_cxx_future_darwin_options"
                ac_c_future_darwin_options=
                ac_cxx_future_darwin_options=
-               ac_fn_check_decl "$LINENO" "strchrnul" "ac_cv_have_decl_strchrnul" "#include <string.h>
+               ac_fn_check_decl "$LINENO" "strchrnul_LOCAL" "ac_cv_have_decl_strchrnul" "#include <string.h>
 " "$ac_c_undeclared_builtin_options$ac_c_future_darwin_options" "CFLAGS"
 if test "x$ac_cv_have_decl_strchrnul" = xyes
 then :
@@ -61432,7 +61432,7 @@ fi
                unset ac_cv_have_decl_strchrnul_saved
              fi
            else
-             ac_fn_c_check_func "$LINENO" "strchrnul" "ac_cv_func_strchrnul"
+             ac_fn_c_check_func "$LINENO" "strchrnul_LOCAL" "ac_cv_func_strchrnul"
 if test "x$ac_cv_func_strchrnul" = xyes
 then :
 
@@ -61444,7 +61444,7 @@ fi
 
 
          *)
-           ac_fn_c_check_func "$LINENO" "strchrnul" "ac_cv_func_strchrnul"
+           ac_fn_c_check_func "$LINENO" "strchrnul_LOCAL" "ac_cv_func_strchrnul"
 if test "x$ac_cv_func_strchrnul" = xyes
 then :
 
diff --git a/lib/spawni.c b/lib/spawni.c
index 0326d89..acb9581 100644
--- a/lib/spawni.c
+++ b/lib/spawni.c
@@ -73,7 +73,7 @@
 # define sigaction __sigaction
 # define sigismember __sigismember
 # define sigprocmask __sigprocmask
-# define strchrnul __strchrnul
+# define strchrnul_LOCAL __strchrnul
 # define vfork __vfork
 #endif
 
@@ -1065,7 +1065,7 @@ __spawni (pid_t *pid, const char *file,
       char *startp;
 
       path = p;
-      p = strchrnul (path, ':');
+      p = strchrnul_LOCAL (path, ':');
 
       if (p == path)
         /* Two adjacent colons, or a colon at the beginning or the end
diff --git a/lib/strchrnul.c b/lib/strchrnul.c
index c3bfebc..e031565 100644
--- a/lib/strchrnul.c
+++ b/lib/strchrnul.c
@@ -21,7 +21,7 @@
 
 /* Find the first occurrence of C in S or the final NUL byte.  */
 char *
-strchrnul (const char *s, int c_in)
+strchrnul_LOCAL (const char *s, int c_in)
 {
   /* On 32-bit hardware, choosing longword to be a 32-bit unsigned
      long instead of a 64-bit uintmax_t tends to give better
diff --git a/lib/string.in.h b/lib/string.in.h
index 1b39150..19f9cfa 100644
--- a/lib/string.in.h
+++ b/lib/string.in.h
@@ -677,42 +677,42 @@ _GL_WARN_ON_USE_CXX (strchr,
 #if @GNULIB_STRCHRNUL@
 # if @REPLACE_STRCHRNUL@
 #  if !(defined __cplusplus && defined GNULIB_NAMESPACE)
-#   define strchrnul rpl_strchrnul
+#   define strchrnul_LOCAL rpl_strchrnul
 #  endif
-_GL_FUNCDECL_RPL (strchrnul, char *, (const char *__s, int __c_in),
+_GL_FUNCDECL_RPL (strchrnul_LOCAL, char *, (const char *__s, int __c_in),
                                      _GL_ATTRIBUTE_PURE
                                      _GL_ARG_NONNULL ((1)));
-_GL_CXXALIAS_RPL (strchrnul, char *,
+_GL_CXXALIAS_RPL (strchrnul_LOCAL, char *,
                   (const char *str, int ch));
 # else
 #  if ! @HAVE_STRCHRNUL@
-_GL_FUNCDECL_SYS (strchrnul, char *, (char const *__s, int __c_in),
+_GL_FUNCDECL_SYS (strchrnul_LOCAL, char *, (char const *__s, int __c_in),
                                      _GL_ATTRIBUTE_PURE
                                      _GL_ARG_NONNULL ((1)));
 #  endif
   /* On some systems, this function is defined as an overloaded function:
        extern "C++" { const char * std::strchrnul (const char *, int); }
        extern "C++" { char * std::strchrnul (char *, int); }  */
-_GL_CXXALIAS_SYS_CAST2 (strchrnul,
+_GL_CXXALIAS_SYS_CAST2 (strchrnul_LOCAL,
                         char *, (char const *__s, int __c_in),
                         char const *, (char const *__s, int __c_in));
 # endif
 # if ((__GLIBC__ == 2 && __GLIBC_MINOR__ >= 10) && !defined __UCLIBC__) \
      && (__GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 4) \
          || defined __clang__)
-_GL_CXXALIASWARN1 (strchrnul, char *,
+_GL_CXXALIASWARN1 (strchrnul_LOCAL, char *,
                    (char *__s, int __c_in)
                    _GL_ATTRIBUTE_NOTHROW);
-_GL_CXXALIASWARN1 (strchrnul, char const *,
+_GL_CXXALIASWARN1 (strchrnul_LOCAL, char const *,
                    (char const *__s, int __c_in)
                    _GL_ATTRIBUTE_NOTHROW);
 # elif __GLIBC__ >= 2
-_GL_CXXALIASWARN (strchrnul);
+_GL_CXXALIASWARN (strchrnul_LOCAL);
 # endif
 #elif defined GNULIB_POSIXCHECK
 # if HAVE_RAW_DECL_STRCHRNUL
-_GL_WARN_ON_USE (strchrnul, "strchrnul is unportable - "
-                 "use gnulib module strchrnul for portability");
+_GL_WARN_ON_USE (strchrnul_LOCAL, "strchrnul is unportable - "
+                 "use gnulib module strchrnul_LOCAL for portability");
 # endif
 #endif
 
diff --git a/tests/test-strchrnul.c b/tests/test-strchrnul.c
index 249d98b..4eaf174 100644
--- a/tests/test-strchrnul.c
+++ b/tests/test-strchrnul.c
@@ -20,7 +20,7 @@
 #include <string.h>
 
 #include "signature.h"
-SIGNATURE_CHECK (strchrnul, char *, (char const *, int));
+SIGNATURE_CHECK (strchrnul_LOCAL, char *, (char const *, int));
 
 #include <stdlib.h>
 
@@ -42,16 +42,16 @@ main (void)
   input[n] = '\0';
 
   /* Basic behavior tests.  */
-  ASSERT (strchrnul (input, 'a') == input);
-  ASSERT (strchrnul (input, 'b') == input + 1);
-  ASSERT (strchrnul (input, 'c') == input + 2);
-  ASSERT (strchrnul (input, 'd') == input + 1026);
+  ASSERT (strchrnul_LOCAL (input, 'a') == input);
+  ASSERT (strchrnul_LOCAL (input, 'b') == input + 1);
+  ASSERT (strchrnul_LOCAL (input, 'c') == input + 2);
+  ASSERT (strchrnul_LOCAL (input, 'd') == input + 1026);
 
-  ASSERT (strchrnul (input + 1, 'a') == input + n - 1);
-  ASSERT (strchrnul (input + 1, 'e') == input + n - 2);
+  ASSERT (strchrnul_LOCAL (input + 1, 'a') == input + n - 1);
+  ASSERT (strchrnul_LOCAL (input + 1, 'e') == input + n - 2);
 
-  ASSERT (strchrnul (input, 'f') == input + n);
-  ASSERT (strchrnul (input, '\0') == input + n);
+  ASSERT (strchrnul_LOCAL (input, 'f') == input + n);
+  ASSERT (strchrnul_LOCAL (input, '\0') == input + n);
 
   /* Check that a very long haystack is handled quickly if the byte is
      found near the beginning.  */
@@ -59,7 +59,7 @@ main (void)
     size_t repeat = 10000;
     for (; repeat > 0; repeat--)
       {
-        ASSERT (strchrnul (input, 'c') == input + 2);
+        ASSERT (strchrnul_LOCAL (input, 'c') == input + 2);
       }
   }
 
@@ -70,9 +70,9 @@ main (void)
         input[i + j] = (j + 1) & 0xff;
       for (int j = 1; j < 256; j++)
         {
-          ASSERT (strchrnul (input + i, j) == input + i + j - 1);
+          ASSERT (strchrnul_LOCAL (input + i, j) == input + i + j - 1);
           input[i + j - 1] = (j == 1 ? 2 : 1);
-          ASSERT (strchrnul (input + i, j) == input + i + 255);
+          ASSERT (strchrnul_LOCAL (input + i, j) == input + i + 255);
           input[i + j - 1] = j;
         }
     }
