 16 files changed, 94 insertions(+), 94 deletions(-)

diff --git a/gettext-runtime/gnulib-lib/string.in.h b/gettext-runtime/gnulib-lib/string.in.h
index 1b39150..19f9cfa 100644
--- a/gettext-runtime/gnulib-lib/string.in.h
+++ b/gettext-runtime/gnulib-lib/string.in.h
@@ -677,42 +677,42 @@ _GL_WARN_ON_USE_CXX (strchr,
 #if @GNULIB_STRCHRNUL@
 # if @REPLACE_STRCHRNUL@
 #  if !(defined __cplusplus && defined GNULIB_NAMESPACE)
-#   define strchrnul rpl_strchrnul
+#   define strchrnul_LOCAL rpl_strchrnul
 #  endif
-_GL_FUNCDECL_RPL (strchrnul, char *, (const char *__s, int __c_in),
+_GL_FUNCDECL_RPL (strchrnul_LOCAL, char *, (const char *__s, int __c_in),
                                      _GL_ATTRIBUTE_PURE
                                      _GL_ARG_NONNULL ((1)));
-_GL_CXXALIAS_RPL (strchrnul, char *,
+_GL_CXXALIAS_RPL (strchrnul_LOCAL, char *,
                   (const char *str, int ch));
 # else
 #  if ! @HAVE_STRCHRNUL@
-_GL_FUNCDECL_SYS (strchrnul, char *, (char const *__s, int __c_in),
+_GL_FUNCDECL_SYS (strchrnul_LOCAL, char *, (char const *__s, int __c_in),
                                      _GL_ATTRIBUTE_PURE
                                      _GL_ARG_NONNULL ((1)));
 #  endif
   /* On some systems, this function is defined as an overloaded function:
        extern "C++" { const char * std::strchrnul (const char *, int); }
        extern "C++" { char * std::strchrnul (char *, int); }  */
-_GL_CXXALIAS_SYS_CAST2 (strchrnul,
+_GL_CXXALIAS_SYS_CAST2 (strchrnul_LOCAL,
                         char *, (char const *__s, int __c_in),
                         char const *, (char const *__s, int __c_in));
 # endif
 # if ((__GLIBC__ == 2 && __GLIBC_MINOR__ >= 10) && !defined __UCLIBC__) \
      && (__GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 4) \
          || defined __clang__)
-_GL_CXXALIASWARN1 (strchrnul, char *,
+_GL_CXXALIASWARN1 (strchrnul_LOCAL, char *,
                    (char *__s, int __c_in)
                    _GL_ATTRIBUTE_NOTHROW);
-_GL_CXXALIASWARN1 (strchrnul, char const *,
+_GL_CXXALIASWARN1 (strchrnul_LOCAL, char const *,
                    (char const *__s, int __c_in)
                    _GL_ATTRIBUTE_NOTHROW);
 # elif __GLIBC__ >= 2
-_GL_CXXALIASWARN (strchrnul);
+_GL_CXXALIASWARN (strchrnul_LOCAL);
 # endif
 #elif defined GNULIB_POSIXCHECK
 # if HAVE_RAW_DECL_STRCHRNUL
-_GL_WARN_ON_USE (strchrnul, "strchrnul is unportable - "
-                 "use gnulib module strchrnul for portability");
+_GL_WARN_ON_USE (strchrnul_LOCAL, "strchrnul is unportable - "
+                 "use gnulib module strchrnul_LOCAL for portability");
 # endif
 #endif
 
