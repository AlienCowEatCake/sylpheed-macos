diff --git a/gettext-tools/gnulib-tests/test-strchrnul.c b/gettext-tools/gnulib-tests/test-strchrnul.c
index 249d98b..4eaf174 100644
--- a/gettext-tools/gnulib-tests/test-strchrnul.c
+++ b/gettext-tools/gnulib-tests/test-strchrnul.c
@@ -20,7 +20,7 @@
 #include <string.h>
 
 #include "signature.h"
-SIGNATURE_CHECK (strchrnul, char *, (char const *, int));
+SIGNATURE_CHECK (strchrnul_LOCAL, char *, (char const *, int));
 
 #include <stdlib.h>
 
@@ -42,16 +42,16 @@ main (void)
   input[n] = '\0';
 
   /* Basic behavior tests.  */
-  ASSERT (strchrnul (input, 'a') == input);
-  ASSERT (strchrnul (input, 'b') == input + 1);
-  ASSERT (strchrnul (input, 'c') == input + 2);
-  ASSERT (strchrnul (input, 'd') == input + 1026);
+  ASSERT (strchrnul_LOCAL (input, 'a') == input);
+  ASSERT (strchrnul_LOCAL (input, 'b') == input + 1);
+  ASSERT (strchrnul_LOCAL (input, 'c') == input + 2);
+  ASSERT (strchrnul_LOCAL (input, 'd') == input + 1026);
 
-  ASSERT (strchrnul (input + 1, 'a') == input + n - 1);
-  ASSERT (strchrnul (input + 1, 'e') == input + n - 2);
+  ASSERT (strchrnul_LOCAL (input + 1, 'a') == input + n - 1);
+  ASSERT (strchrnul_LOCAL (input + 1, 'e') == input + n - 2);
 
-  ASSERT (strchrnul (input, 'f') == input + n);
-  ASSERT (strchrnul (input, '\0') == input + n);
+  ASSERT (strchrnul_LOCAL (input, 'f') == input + n);
+  ASSERT (strchrnul_LOCAL (input, '\0') == input + n);
 
   /* Check that a very long haystack is handled quickly if the byte is
      found near the beginning.  */
@@ -59,7 +59,7 @@ main (void)
     size_t repeat = 10000;
     for (; repeat > 0; repeat--)
       {
-        ASSERT (strchrnul (input, 'c') == input + 2);
+        ASSERT (strchrnul_LOCAL (input, 'c') == input + 2);
       }
   }
 
@@ -70,9 +70,9 @@ main (void)
         input[i + j] = (j + 1) & 0xff;
       for (int j = 1; j < 256; j++)
         {
-          ASSERT (strchrnul (input + i, j) == input + i + j - 1);
