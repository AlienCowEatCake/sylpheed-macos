From de58f236430a8402c69fb345fc70711b8af6501a Mon Sep 17 00:00:00 2001
From: Peter Zhigalov <peter.zhigalov@gmail.com>
Date: Tue, 29 Sep 2026 05:19:22 +0700
Subject: [PATCH 3/3] GETTEXT: disable strchrnul

/gettext-1.0/gettext-tools/gnulib-lib/spawni.c:1068:11: error: 'strchrnul' is only available on macOS 15.4 or newer

find . -name 'configure' -exec gsed -i 's|\(ac_fn_c[^ ]* [^ ]* "strchrnul\)"|\1_LOCAL"|' \{\} \;
find . \( -name '*.h' -or -name '*.c' \) -exec gsed -i 's|\([( ]strchrnul\)|\1_LOCAL|g ; s|^\(strchrnul\)|\1_LOCAL|g' \{\} \;
---
 gettext-runtime/gnulib-lib/string.in.h        | 20 ++++++++--------
 gettext-runtime/intl/gnulib-lib/string.in.h   | 20 ++++++++--------
 .../libasprintf/gnulib-lib/string.in.h        | 20 ++++++++--------
 gettext-tools/configure                       | 24 +++++++++----------
 gettext-tools/gnulib-lib/spawni.c             |  4 ++--
 gettext-tools/gnulib-lib/strchrnul.c          |  2 +-
 gettext-tools/gnulib-lib/string.in.h          | 20 ++++++++--------
