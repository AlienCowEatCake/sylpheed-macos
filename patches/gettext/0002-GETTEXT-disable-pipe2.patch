From 6ae5203dd1c59ad6222631b4415e9e1f42c62a2b Mon Sep 17 00:00:00 2001
From: Peter Zhigalov <peter.zhigalov@gmail.com>
Date: Tue, 29 Sep 2026 05:13:11 +0700
Subject: [PATCH 2/3] GETTEXT: disable pipe2

gettext-0.25/gettext-tools/gnulib-lib/pipe2.c:57:22: error: 'pipe2' is only available on macOS 27.0 or newer

find . -name 'configure' -exec gsed -i 's|\(ac_fn_c[^ ]* [^ ]* "pipe2\)"|\1_LOCAL"|' \{\} \;
find . \( -name '*.h' -or -name '*.c' \) -exec gsed -i 's|\([( ]pipe2\)|\1_LOCAL|g ; s|^\(pipe2\)|\1_LOCAL|g' \{\} \;
---
